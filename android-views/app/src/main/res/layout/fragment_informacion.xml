<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_m">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_m"
            android:text="@string/s5_intro"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <!-- 1. Textos -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="TextView (textAppearance, textStyle, Spannable)"
            app:descripcion="@string/s5_textos_d"
            app:titulo="@string/s5_textos_t">

            <TextView
                android:id="@+id/tvDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s5_display"
                android:textAppearance="?attr/textAppearanceDisplaySmall" />

            <TextView
                android:id="@+id/tvHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s5_headline"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s5_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/tvBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s5_body"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:text="@string/s5_label"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s5_negrita"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s5_cursiva"
                android:textStyle="italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s5_color"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSpan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/espacio_s" />

            <TextView
                android:id="@+id/tvAjustable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTertiary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swMayus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:text="@string/s5_mayus" />
        </mx.ipn.catalogo.views.ui.DemoCard>

        <!-- 2. Imágenes -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="ImageView (scaleType) + Coil"
            app:descripcion="@string/s5_img_d"
            app:titulo="@string/s5_img_t">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgEscala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chipCrop"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCrop"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="centerCrop" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFit"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="fitCenter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCenter"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="center" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipXY"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="fitXY" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivLocal"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:contentDescription="@string/s5_img_desc_local"
                        android:scaleType="centerCrop"
                        android:src="@drawable/paisaje" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/s5_img_local"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_s"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivRemota"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:contentDescription="@string/s5_img_desc_url"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/s5_img_url"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOtraImagen"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:text="@string/s5_otra_img"
                app:icon="@drawable/ic_refresh" />
        </mx.ipn.catalogo.views.ui.DemoCard>

        <!-- 3. Progreso -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="LinearProgressIndicator / CircularProgressIndicator"
            app:descripcion="@string/s5_prog_d"
            app:titulo="@string/s5_prog_t">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/lpDeterminado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="40" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/cpDeterminado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_m"
                    android:max="100"
                    android:progress="40" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProgreso"
                style="@style/Resultado" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenos"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="−10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMas"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_s"
                    android:text="+10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_s"
                    android:text="@string/s5_simular" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swIndeterminado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:checked="true"
                android:text="@string/s5_indeterminados" />

            <LinearLayout
                android:id="@+id/filaIndeterminados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:indeterminate="true" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_m"
                    android:indeterminate="true" />
            </LinearLayout>
        </mx.ipn.catalogo.views.ui.DemoCard>

        <!-- 4. Toast y Snackbar -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="Toast / Snackbar"
            app:descripcion="@string/s5_msg_d"
            app:titulo="@string/s5_msg_t">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToast"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/s5_toast" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSnackbar"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_s"
                    android:text="@string/s5_snack" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMensajes"
                style="@style/Resultado" />
        </mx.ipn.catalogo.views.ui.DemoCard>

        <!-- 5. Diálogo -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="MaterialAlertDialogBuilder"
            app:descripcion="@string/s5_dialogo_d"
            app:titulo="@string/s5_dialogo_t">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/s5_dialogo_btn"
                app:icon="@drawable/ic_delete" />

            <TextView
                android:id="@+id/tvDialogo"
                style="@style/Resultado" />
        </mx.ipn.catalogo.views.ui.DemoCard>

        <!-- 6. Hoja inferior -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="BottomSheetDialog"
            app:descripcion="@string/s5_hoja_d"
            app:titulo="@string/s5_hoja_t">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHoja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/s5_hoja_btn" />

            <TextView
                android:id="@+id/tvHoja"
                style="@style/Resultado" />
        </mx.ipn.catalogo.views.ui.DemoCard>

        <!-- 7. Tarjeta, separador y badge -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="MaterialCardView / MaterialDivider / badge"
            app:descripcion="@string/s5_tarjeta_d"
            app:titulo="@string/s5_tarjeta_t">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEjemplo"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_m">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/s5_tarjeta_titulo"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/espacio_s" />

                    <TextView
                        android:id="@+id/tvTarjeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/s5_tarjeta_texto"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/espacio_m" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/s5_notificar"
                        android:src="@drawable/ic_notifications" />

                    <TextView
                        android:id="@+id/tvBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_badge"
                        android:gravity="center"
                        android:minWidth="20dp"
                        android:paddingHorizontal="5dp"
                        android:textColor="?attr/colorOnError"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotificar"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_s"
                    android:text="@string/s5_notificar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLimpiar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/s5_limpiar" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeInfo"
                style="@style/Resultado" />
        </mx.ipn.catalogo.views.ui.DemoCard>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
