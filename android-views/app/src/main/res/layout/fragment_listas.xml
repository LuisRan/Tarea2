<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_m">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_m"
            android:text="@string/s4_intro"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <!-- 1. Lista vertical con detalle, deslizar para eliminar y actualizar -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="RecyclerView + ItemTouchHelper + SwipeRefreshLayout"
            app:descripcion="@string/s4_lista_d"
            app:titulo="@string/s4_lista_t">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvConteo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVaciar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/s4_vaciar"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="@drawable/bg_contorno"
                android:padding="1dp">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/srl"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLista"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <!-- Estado vacío -->
                <LinearLayout
                    android:id="@+id/estadoVacio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:contentDescription="@string/s4_vacio_titulo"
                        android:src="@drawable/ic_inbox"
                        android:tint="?attr/colorOutline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:text="@string/s4_vacio_titulo"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/s4_vacio_msg"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestaurar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:text="@string/s4_restaurar"
                        app:icon="@drawable/ic_refresh" />
                </LinearLayout>
            </FrameLayout>
        </mx.ipn.catalogo.views.ui.DemoCard>

        <!-- 2. Estado vacío (explicación) -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="LinearLayout con ImageView + TextView (visibilidad según la lista)"
            app:descripcion="@string/s4_vacio_d"
            app:titulo="@string/s4_vacio_t">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerVacio"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/s4_vaciar" />
        </mx.ipn.catalogo.views.ui.DemoCard>

        <!-- 3. Cuadrícula -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="RecyclerView + GridLayoutManager"
            app:descripcion="@string/s4_grid_d"
            app:titulo="@string/s4_grid_t">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCuadricula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvColor"
                style="@style/Resultado"
                android:text="@string/s4_grid_toca" />
        </mx.ipn.catalogo.views.ui.DemoCard>

        <!-- 4. Lista con encabezados -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="RecyclerView con getItemViewType (2 tipos)"
            app:descripcion="@string/s4_secciones_d"
            app:titulo="@string/s4_secciones_t">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSecciones"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/bg_contorno"
                android:padding="1dp" />
        </mx.ipn.catalogo.views.ui.DemoCard>

        <!-- 5. Pestañas -->
        <mx.ipn.catalogo.views.ui.DemoCard
            style="@style/Demo"
            app:componente="TabLayout + ViewPager2"
            app:descripcion="@string/s4_tabs_d"
            app:titulo="@string/s4_tabs_t">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="180dp" />
        </mx.ipn.catalogo.views.ui.DemoCard>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
